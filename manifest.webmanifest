{
  "name": "holoTCG Collection",
  "short_name": "holoTCG",
  "description": "Offline card collection, deck builder and browser for the hololive OFFICIAL CARD GAME.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
